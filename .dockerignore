# Keeps the build context (repo root — see docker-compose.yml's build.context) small and
# never lets a secret or a dev cache end up baked into an image layer.

.git
.gitignore

# Python
**/__pycache__
**/*.py[cod]
server/.venv
.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info

# Secrets — never bake these into an image
.env
.env.*
!.env.example
server/.env

# Dev-only data, not needed at runtime (agent/loader.py only reads data/)
server/.local_storage
evals

# Not part of the server image
android
docs
scripts

# OS / editor
.DS_Store
.idea
.vscode
