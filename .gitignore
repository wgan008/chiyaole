# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
server/.env

# Android
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab
*.jks
*.keystore

# Local dev DB/storage stand-ins — never real data, never committed. *.db catches
# server/local_dev.db specifically — it holds real caregiver access_token values, which
# function as this app's login credentials (deps.py's "never types a password" model), not
# just disposable test rows.
server/.local_storage/
*.db
*.sqlite
*.sqlite3

# Real user data — MUST NOT be committed (spec §8.6)
evals/asr_samples/*.wav
evals/asr_samples/*.m4a
evals/labs/real/
field-notes/*-private.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
