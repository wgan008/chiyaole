# ---- Alibaba Cloud Model Studio (DashScope) ----
DASHSCOPE_API_KEY=

# ---- Alibaba Cloud OSS ----
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_BUCKET=chiyaole-poc
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---- PushPlus (caregiver WeChat delivery) ----
PUSHPLUS_TOKEN=

# ---- Database ----
DATABASE_URL=postgresql+psycopg://chiyaole:chiyaole@localhost:5432/chiyaole

# ---- App ----
# BASE_URL must match wherever THIS server is actually reachable, per environment:
#   local dev, Android EMULATOR consumer : http://10.0.2.2:8000
#     ★ NOT http://localhost:8000 — "localhost" inside the emulator's network namespace
#     means the emulator itself, not the host machine, so the app can't fetch anything
#     built from this URL (e.g. medbox photos never load on the alarm screen). 10.0.2.2 is
#     the emulator's alias for the host — same address used for BuildConfig.API_BASE_URL.
#     A real device on the same Wi-Fi instead of an emulator needs the host's actual LAN
#     IP here, not 10.0.2.2 (that alias only exists inside the emulator's virtual network).
#   cloud dev/staging : https://staging-api.chiyaole.cn (or your HK VPS's domain)
#   cloud prod         : https://api.chiyaole.cn
BASE_URL=http://10.0.2.2:8000
ENV=dev

# ---- Production only (docker-compose.prod.yml's Caddy service) ----
# The domain Caddy requests a Let's Encrypt certificate for — its DNS A record must
# already point at this host. Leave blank for local/dev; only used by the prod overlay.
# ★ Must match BASE_URL above (same domain, https://).
CHIYAOLE_DOMAIN=
